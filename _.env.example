# Copia este archivo como ".env" y ajusta los valores.
# Si la contraseña tiene caracteres especiales (@ : / # %), codifícalos
# (ej. @ -> %40) o cámbiala por una más simple.
DATABASE_URL=postgresql://app_backend:CAMBIAR_ESTA_CLAVE@localhost:5432/sih_farmacia

# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

FLASK_DEBUG=1
# Pon 1 cuando uses HTTPS en producción
COOKIE_SECURE=0
